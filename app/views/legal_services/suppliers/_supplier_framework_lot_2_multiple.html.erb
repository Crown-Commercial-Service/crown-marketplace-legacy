<% fetch_services_with_suppliers_for_lot_2.each do |service_name, supplier_frameworks| %>
  <% if supplier_frameworks.any? %>
    <h2 class="govuk-heading-m"><%= service_name %></h2>

    <ul class="govuk-list govuk-!-margin-left-4">
        <% supplier_frameworks.each do |supplier_framework| %>

            <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible  govuk-!-margin-top-2 govuk-!-margin-bottom-2">

            <li class="govuk-body-m govuk-!-margin-bottom-1">
            <%= link_to supplier_framework.supplier.name, legal_services_rm6374_supplier_path(supplier_framework.id, **@journey.params), class: 'govuk-link govuk-link--no-underline' %>

            <% if supplier_framework.supplier.sme %>
                <%= govuk_tag(t('sme'), 'grey', classes: 'ccs-tag govuk-!-font-size-14') %>
            <% end %>

            <% if (prospectus_url = prospectus_link_for_list_page(supplier_framework)).present? %>
                <div class="ccs-results-list__prospectus govuk-!-margin-top-1">
                <%= link_to prospectus_url, url_formatter(prospectus_url), class: 'govuk-link ccs-no-underline' %>
                </div>
            <% end %>

            </li>
        <% end %>
    </ul>
  <% end %>

<% end %>