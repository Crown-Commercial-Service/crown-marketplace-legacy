<% services = @journey.current_step.fetch_selected_lot_2_services %>
<% supplier_frameworks_with_rates = @journey.current_step.supplier_frameworks_with_rates_for_lot_2 %>

<% if @journey.current_step.single_or_multiple_suppliers == "multiple" %>
    <% comparison_partial = if checkboxes
        'legal_services/rm6374/journey/lot_2/comparison_with_checkboxes'
    else
        'legal_services/rm6374/journey/lot_2/comparison_without_checkboxes'
    end %>

    <%= govuk_tabs(
        services.map do |service|
        {
            label: service.name,
            panel: {
            content: render( partial: comparison_partial, locals: { service: service, supplier_frameworks_with_rates: supplier_frameworks_with_rates }),
            attributes: {
                id: service.id.to_s.gsub('.', '-')
            }
            }
        }
        end
    ) %>

<% else %>
    <% if checkboxes %>
        <%= render partial: 'legal_services/rm6374/journey/lot_2/single_supplier_comparison_checkboxes', locals: { services: services, supplier_frameworks_with_rates: supplier_frameworks_with_rates } %>
    <% else %>
        <%= render partial: 'legal_services/rm6374/journey/lot_2/single_supplier_comparison', locals: { services: services, supplier_frameworks_with_rates: supplier_frameworks_with_rates } %>
    <% end %>
<% end %>


