<div class="ccs-suppliers-comparison-container">
  <% 
    service_supplier_rates = @journey.current_step.supplier_frameworks_with_rates_for_lot_2.select do |_supplier_framework, rates|
      service_rates = rates[service.id] || {}
      
      service_rates.values.any? do |rate_entry|
        rate_obj = rate_entry.is_a?(Hash) ? rate_entry.values.first : rate_entry
        rate_obj&.rate.to_f > 0
      end
    end
  %>

  <% if service_supplier_rates.empty? %>
    <p class="govuk-body">
      <%= t('.no_suppliers_found_html') %>
    </p>
  <% else %>
    <p class="govuk-body">
      <%= t('.scroll_to_the_right') %>
    </p>

    <div class="ccs-suppliers-comparison-overflow-container">
      <%= govuk_table(
        [
          { text: t('.supplier') }
        ] + @journey.current_step.positions.map do |_position_id, position_name|
          {
            text: t("shared.rates_table.rm6374.job_titles.#{position_name}")
          }
        end,

        service_supplier_rates.map do |supplier_framework, rates|
          service_rates = rates[service.id] || {}
          framework_id = supplier_framework.id

          supplier_cell_content = content_tag(:div) do
            checkbox_section = content_tag(:div, class: 'govuk-checkboxes govuk-checkboxes--small ccs-checkbox--no-hover', data: { module: 'govuk-checkboxes' }) do
              content_tag(:div, class: 'govuk-checkboxes__item') do
                checkbox_input = check_box_tag(
                  'supplier_framework_ids[]',
                  framework_id,
                  false,
                  class: 'govuk-checkboxes__input',
                  id: "supplier_framework_ids_#{service.id.to_s.gsub('.', '_')}_#{framework_id}"
                )

                supplier_name_wrapper = content_tag(:div, class: 'ccs-results-list__supplier-name') do
                  supplier_name = content_tag(:span, supplier_framework.supplier_name, class: 'govuk-body-s govuk-!-font-weight-bold')

                  sme_tag = if supplier_framework.supplier&.sme?
                    ' '.html_safe + govuk_tag(t('sme'), 'grey', classes: 'ccs-tag')
                  else
                    ''.html_safe
                  end

                  supplier_name + sme_tag
                end

                checkbox_label = label_tag("supplier_framework_ids_#{service.id.to_s.gsub('.', '_')}_#{framework_id}", class: 'govuk-label govuk-checkboxes__label') do
                  supplier_name_wrapper
                end

                checkbox_input + checkbox_label
              end
            end

            supplier_info_wrapper = content_tag(
              :ul, 
              class: 'govuk-list govuk-list--inline govuk-!-margin-top-1 govuk-!-margin-bottom-0 govuk-!-font-size-16',
              style: 'display: flex; gap: 15px; flex-wrap: nowrap; white-space: nowrap; margin-left: 35px;'
            ) do
              details_link = content_tag(:li) do
                link_to 'View supplier detail', legal_services_rm6374_supplier_path(supplier_framework, **@journey.params), class: 'govuk-link'
              end

              prospectus_link = if supplier_framework.contact_detail&.website.present?
                content_tag(:li) do
                  link_to 'View supplier prospectus', url_formatter(supplier_framework.contact_detail.website), class: 'govuk-link', target: '_blank', rel: 'noopener noreferrer'
                end
              else
                ''.html_safe
              end

              details_link + prospectus_link
            end

            checkbox_section + supplier_info_wrapper
          end

          [
            {
              text: supplier_cell_content
            }
          ] + @journey.current_step.positions.map do |position_id, _position_name|
            {
              text: display_rate(position_id, service_rates)
            }
          end
        end,
        caption: {
          text: t('.rates'),
          classes: 'govuk-visually-hidden'
        },
        first_cell_is_header: true,
        classes: 'ccs-suppliers-comparison-table'
      ) %>
    </div>
  <% end %>
</div>