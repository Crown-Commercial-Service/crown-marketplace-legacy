<% services = @journey.current_step.fetch_selected_lot_2_services %>

<%= govuk_tabs(
    services.map do |service|
    {
        label: service.name,
        panel: {
        content: render( partial: 'legal_services/rm6374/journey/lot_2_comparison_rates_table', locals: { service: service }),
        attributes: {
            id: service.id.to_s.gsub('.', '-')
        }
        }
    }
    end
) %>