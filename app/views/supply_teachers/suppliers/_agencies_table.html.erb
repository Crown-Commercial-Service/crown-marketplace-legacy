<%= paginate supplier_frameworks, views_prefix: 'shared', window: 0, outer_window: 2, params: { controller: :suppliers, action: :all_suppliers } %>

<%= govuk_table(
  [
    {
      text: tag.span(t(".agencies_found.#{supplier_frameworks_total == 1 ? 'singular' : 'plural'}", total: supplier_frameworks_total) , class: 'govuk-!-font-size-27')
    }
  ],
  if supplier_frameworks.empty?
    [
      [
        {
          text: t('.no_agencies_found')
        }
      ]
    ]
  else
    supplier_frameworks.map do |supplier_framework|
      supplier_name = supplier_framework.supplier_name
      trading_name = supplier_framework.supplier.additional_details&.dig('trading_name').presence
      [
        {
          text: safe_join([
            tag.h2(class: 'govuk-heading-m govuk-!-margin-bottom-1') do
              link_to(supplier_name, show_path(supplier_framework), class: 'govuk-link ccs-no-underline')
            end,
            if trading_name.present? && trading_name != supplier_name
              tag.span("Trading as #{trading_name}", class: 'govuk-body govuk-!-margin-bottom-0')
            end
          ].compact),
          classes: 'agency-row'
        }
      ]
    end
  end,
) %>

<%= paginate supplier_frameworks, views_prefix: 'shared', window: 0, outer_window: 2, params: { controller: :suppliers, action: :all_suppliers } %>
